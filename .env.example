POSTGRES_PASSWORD=replace-with-a-private-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value

ACCESSFLOW_APPROVAL_API_KEY=replace-with-a-second-long-random-value
ACCESSFLOW_DATABASE_URL=postgresql+psycopg://accessflow:replace-with-a-private-password@db:5432/accessflow
ACCESSFLOW_LOG_LEVEL=INFO

ACCESSFLOW_GITHUB_API_URL=https://api.github.com
ACCESSFLOW_GITHUB_API_VERSION=2026-03-10
ACCESSFLOW_GITHUB_TOKEN=replace-with-a-read-only-github-token
ACCESSFLOW_GITHUB_TIMEOUT_SECONDS=5
ACCESSFLOW_GITHUB_MAX_RETRIES=2
ACCESSFLOW_GITHUB_RETRY_BASE_SECONDS=0.25
ACCESSFLOW_GITHUB_MAX_PAGES=5